          ".validate": "newData.isString() && root.child('checklists').child(newData.val()).exists()"
        },
        "assets": {
          "$a": {
            ".validate": "newData.val() == true"
          }
        },
        "jobs": {
          "$at": {
            ".validate": "$at.matches(/^[0-9]+$/) && newData.isString() && root.child('jobs').child(newData.val()).exists()"
          }
        },
        "history": {
          "$h": {
            ".validate": "newData.hasChildren(['at', 'note']) && !data.exists()",
            "note": {
              ".validate": "newData.isString() && newData.val().length <= 3000"
            }
          }
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "createdBy": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "updatedBy": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "files": {
          ".validate": false
        },
        "cpfm": {
          ".validate": false
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "counters": {
      "jobs": {
        "$key": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "$key.matches(/^[A-Z]{2}20[0-9][0-9]$/) && newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)"
        }
      },
      "pm": {
        "$year": {
          ".read": "(auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin'))",
          ".write": "(auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin'))",
          ".validate": "$year.matches(/^20[0-9][0-9]$/) && newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)"
        }
      }
    },
    "jobs": {
      ".read": "(auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')) || (auth != null && query.orderByChild == 'reporterUid' && query.equalTo == auth.uid)",
      ".indexOn": [
        "createdAt",
        "status",
        "reporterUid",
        "siteId",
        "jobNo",
        "assetId",
        "pm/planId",
        "idx/s",
        "idx/o",
        "idx/si",
        "idx/sis",
        "idx/sio",
        "idx/b",
        "idx/bs",
        "idx/bo"
      ],
      "$jobId": {
        ".read": "(auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')) || (auth != null && (data.child('reporterUid').val() == auth.uid || (auth != null && data.child('assigneeKeys').isString() && (data.child('assigneeKeys').val().contains(',' + auth.uid + ',') || (root.child('users').child(auth.uid).child('staffId').isString() && data.child('assigneeKeys').val().contains(',' + root.child('users').child(auth.uid).child('staffId').val() + ','))))))",
        ".write": "((auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')) && (newData.exists() || (auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'))) || (auth != null && !data.exists() && newData.child('reporterUid').val() == auth.uid && newData.child('status').val() == 'new'     && !newData.hasChild('assigneeKeys') && !newData.hasChild('assignees') && !newData.hasChild('expectedDate')     && newData.child('jobNo').val().beginsWith(root.child('config').child('public').child('jobPrefix').isString() ? root.child('config').child('public').child('jobPrefix').val() + '20' : 'VR20')     && newData.parent().parent().child('tracking').child(newData.child('jobNo').val()).child('jobId').val() == $jobId) || ((auth != null && root.child('users').child(auth.uid).child('role').val() == 'contractor') && data.exists() && newData.exists() && (auth != null && data.child('assigneeKeys').isString() && (data.child('assigneeKeys').val().contains(',' + auth.uid + ',') || (root.child('users').child(auth.uid).child('staffId').isString() && data.child('assigneeKeys').val().contains(',' + root.child('users').child(auth.uid).child('staffId').val() + ',')))) && newData.child('assigneeKeys').val() == data.child('assigneeKeys').val())",
        ".validate": "newData.hasChildren(['jobNo', 'status', 'reporterUid', 'jobTypeId', 'buildingId', 'description', 'createdAt']) && (!data.exists() || (newData.child('jobNo').val() == data.child('jobNo').val() && newData.child('reporterUid').val() == data.child('reporterUid').val()))",
        "jobNo": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{2}20[0-9][0-9]-[0-9]{4,}$/)"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(new|assigned|in_progress|on_hold|completed|cancelled)$/)"
        },
        "priority": {
          ".validate": "newData.isString() && newData.val().matches(/^(normal|urgent|low|callback)$/)"
        },
        "jobTypeId": {
          ".validate": "newData.isString() && root.child('jobTypes').child(newData.val()).exists()"
        },
        "siteId": {
          ".validate": "newData.isString() && root.child('sites').child(newData.val()).exists()"
        },
        "buildingId": {
          ".validate": "newData.isString() && root.child('buildings').child(newData.val()).exists()"
        },
        "areaId": {
          ".validate": "newData.isString()"
        },
        "locationDetail": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 3000 && newData.val().length > 0"
        },
        "gps": {
          ".validate": "newData.hasChildren(['lat', 'lng'])",
          "lat": {
            ".validate": "newData.isNumber()"
          },
          "lng": {
            ".validate": "newData.isNumber()"
          },
          "accuracy": {
            ".validate": "newData.isNumber()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$o": {
            ".validate": false
          }
        },
        "reporterUid": {
          ".validate": "newData.isString()"
        },
        "reporter": {
          ".validate": "newData.hasChildren(['name', 'email', 'phone'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().length > 0"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length <= 160 && newData.val().length > 0"
          },
          "phone": {
            ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().length > 0"
          },
          "department": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "$o": {
            ".validate": false
          }
        },
        "lang": {
          ".validate": "newData.isString() && newData.val().matches(/^(th|en)$/)"
        },
        "pdpaAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "assignees": {
          "$k": {
            ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().length > 0"
          }
        },
        "assigneeKeys": {
          ".validate": "newData.isString() && newData.val().length <= 2000 && newData.val().matches(/^,([-_A-Za-z0-9]+,)+$/)"
        },
        "assigneeName": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "expectedDate": {
          ".validate": "newData.isNumber()"
        },
        "expectedNote": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "hold": {
          "reason": {
            ".validate": "newData.isString() && newData.val().matches(/^(waiting_parts|budget|contractor|access|other)$/)"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "resumeDate": {
            ".validate": "newData.isNumber()"
          },
          "partsEta": {
            ".validate": "newData.isNumber()"
          },
          "since": {
            ".validate": "newData.isNumber()"
          },
          "$o": {
            ".validate": false
          }
        },
        "workDetail": {
          ".validate": "newData.isString() && newData.val().length <= 3000"
        },
        "assetId": {
          ".validate": "newData.isString() && root.child('assets').child(newData.val()).exists()"
        },
        "pm": {
          ".validate": "newData.hasChildren(['planId', 'at'])",
          "planId": {
            ".validate": "newData.isString() && root.child('pmPlans').child(newData.val()).exists()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$o": {
            ".validate": false
          }
        },
        "photos": {
          "$pid": {
            ".write": "auth != null && data.parent().parent().child('reporterUid').val() == auth.uid",
            ".validate": "newData.hasChildren(['store', 'w', 'h', 'bytes']) && newData.child('w').val() <= 1280 && newData.child('h').val() <= 1280 && newData.child('bytes').val() <= 409600"
          }
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "updatedAt": {
          ".write": "auth != null && data.parent().child('reporterUid').val() == auth.uid",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "completedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "idx": {
          "$k": {
            ".validate": "$k.matches(/^(s|o|si|sis|sio|b|bs|bo)$/) && newData.isString() && newData.val().length <= 200"
          }
        },
        "files": {
          ".validate": false
        },
        "cpfm": {
          ".validate": false
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "jobPhotos": {
      "$jobId": {
        ".read": "(auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')) || (auth != null && root.child('jobs').child($jobId).child('reporterUid').val() == auth.uid) || (auth != null && root.child('jobs').child($jobId).child('assigneeKeys').isString() && (root.child('jobs').child($jobId).child('assigneeKeys').val().contains(',' + auth.uid + ',') || (root.child('users').child(auth.uid).child('staffId').isString() && root.child('jobs').child($jobId).child('assigneeKeys').val().contains(',' + root.child('users').child(auth.uid).child('staffId').val() + ','))))",
        "$pid": {
          ".write": "(auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')) || (auth != null && root.child('jobs').child($jobId).child('reporterUid').val() == auth.uid) || (auth != null && root.child('jobs').child($jobId).child('assigneeKeys').isString() && (root.child('jobs').child($jobId).child('assigneeKeys').val().contains(',' + auth.uid + ',') || (root.child('users').child(auth.uid).child('staffId').isString() && root.child('jobs').child($jobId).child('assigneeKeys').val().contains(',' + root.child('users').child(auth.uid).child('staffId').val() + ','))))",
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/webp;base64,') && newData.val().length < 560000"
        }
      }
    },
    "jobEvents": {
      "$jobId": {
        ".read": "(auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')) || (auth != null && root.child('jobs').child($jobId).child('assigneeKeys').isString() && (root.child('jobs').child($jobId).child('assigneeKeys').val().contains(',' + auth.uid + ',') || (root.child('users').child(auth.uid).child('staffId').isString() && root.child('jobs').child($jobId).child('assigneeKeys').val().contains(',' + root.child('users').child(auth.uid).child('staffId').val() + ','))))",
        "$eventId": {
          ".write": "auth != null && !data.exists() && newData.child('byUid').val() == auth.uid && ((auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')) || ((auth != null && root.child('users').child(auth.uid).child('role').val() == 'contractor') && (auth != null && newData.parent().parent().parent().child('jobs').child($jobId).child('assigneeKeys').isString() && (newData.parent().parent().parent().child('jobs').child($jobId).child('assigneeKeys').val().contains(',' + auth.uid + ',') || (root.child('users').child(auth.uid).child('staffId').isString() && newData.parent().parent().parent().child('jobs').child($jobId).child('assigneeKeys').val().contains(',' + root.child('users').child(auth.uid).child('staffId').val() + ','))))) || (newData.parent().parent().parent().child('jobs').child($jobId).child('reporterUid').val() == auth.uid     && newData.child('public').val() == true && newData.child('type').val().matches(/^(created|comment)$/)))",
          ".validate": "newData.hasChildren(['at', 'byUid', 'type', 'public']) && newData.child('type').val().matches(/^(created|status|assign|unassign|expected|hold|comment|photo)$/)",
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 3000"
          },
          "public": {
            ".validate": "newData.isBoolean()"
          },
          "imported": {
            ".validate": false
          }
        }
      }
    },
    "tracking": {
      "$no": {
        ".read": true,
        ".write": "(auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')) || (auth != null && !data.exists() && newData.parent().parent().child('jobs').child(newData.child('jobId').val()).child('reporterUid').val() == auth.uid     && newData.parent().parent().child('jobs').child(newData.child('jobId').val()).child('jobNo').val() == $no) || ((auth != null && root.child('users').child(auth.uid).child('role').val() == 'contractor') && data.exists() && newData.exists() && (auth != null && root.child('jobs').child(data.child('jobId').val()).child('assigneeKeys').isString() && (root.child('jobs').child(data.child('jobId').val()).child('assigneeKeys').val().contains(',' + auth.uid + ',') || (root.child('users').child(auth.uid).child('staffId').isString() && root.child('jobs').child(data.child('jobId').val()).child('assigneeKeys').val().contains(',' + root.child('users').child(auth.uid).child('staffId').val() + ',')))))",
        ".validate": "newData.hasChildren(['jobId', 'jobNo', 'status']) && newData.child('jobNo').val() == $no && (!data.exists() || newData.child('jobId').val() == data.child('jobId').val())",
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(new|assigned|in_progress|on_hold|completed|cancelled)$/)"
        },
        "updatedAt": {
          ".write": "auth != null && root.child('jobs').child(data.parent().child('jobId').val()).child('reporterUid').val() == auth.uid",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "timeline": {
          "$eid": {
            ".write": "auth != null && !data.exists() && root.child('jobs').child(data.parent().parent().child('jobId').val()).child('reporterUid').val() == auth.uid && newData.child('type').val() == 'comment'",
            ".validate": "newData.hasChildren(['at', 'type'])",
            "note": {
              ".validate": "newData.isString() && newData.val().length <= 3000"
            }
          }
        }
      }
    },
    "mail": {
      ".read": "(auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin')",
      ".write": false
    }
  }
}

{
  "rules": {
    ".read": false,
    ".write": false,
    "config": {
      "public": {
        ".read": true,
        ".write": "(auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin')",
        "jobPrefix": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{2}$/)"
        }
      }
    },
    "users": {
      ".read": "(auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin'))",
      ".indexOn": [
        "role",
        "email"
      ],
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || (auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')))",
        ".write": "auth != null && (auth.uid == $uid || (auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'))",
        ".validate": "newData.hasChildren(['role'])",
        "role": {
          ".validate": "newData.isString() && newData.val().matches(/^(user|contractor|technician|admin)$/) && ((auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin') || (!data.exists() && newData.val() == 'user') || data.val() == newData.val() || (data.val() == 'user' && auth.token.email != null && auth.token.email_verified == true     && root.child('invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('role').val() == newData.val()))"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "department": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "company": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "staffId": {
          ".validate": "newData.isString() && ((auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin') || (!data.exists() && newData.parent().parent().parent().child('staff').child(newData.val()).child('uid').val() == $uid))"
        },
        "lang": {
          ".validate": "newData.isString() && newData.val().matches(/^(th|en)$/)"
        },
        "providers": {
          "$p": {
            ".validate": "newData.isBoolean()"
          }
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "lastLoginAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "invites": {
      ".read": "(auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin')",
      "$key": {
        ".read": "auth != null && auth.token.email != null && $key == auth.token.email.toLowerCase().replace('.', ',')",
        ".write": "(auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin')",
        ".validate": "newData.hasChildren(['email', 'role']) && newData.child('role').val().matches(/^(contractor|technician)$/)"
      }
    },
    "staff": {
      ".read": "(auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')) || (auth != null && auth.token.email != null && query.orderByChild == 'email' && query.equalTo == auth.token.email.toLowerCase())",
      ".indexOn": [
        "email",
        "uid"
      ],
      "$id": {
        ".write": "(auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin')",
        ".validate": "newData.hasChildren(['name'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().length > 0"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 200 && newData.val() == newData.val().toLowerCase()"
        },
        "uid": {
          ".write": "auth != null && !data.exists() && newData.val() == auth.uid && auth.token.email_verified == true && root.child('staff').child($id).child('email').val() == auth.token.email.toLowerCase()",
          ".validate": "newData.isString()"
        },
        "role": {
          ".validate": "newData.isString() && newData.val().matches(/^(contractor|technician)$/)"
        },
        "company": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "code": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "siteId": {
          ".validate": "newData.isString()"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "order": {
          ".validate": "newData.isNumber()"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "cpfm": {
          ".validate": false
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "assignments": {
      "$key": {
        ".read": "(auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')) || (auth != null && ($key == auth.uid || root.child('users').child(auth.uid).child('staffId').val() == $key))",
        "$jobId": {
          ".write": "(auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin'))",
          ".validate": "newData.val() == true"
        }
      }
    },
    "sites": {
      ".read": true,
      ".write": "(auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin')",
      "$id": {
        ".validate": "newData.hasChildren(['nameTh'])"
      }
    },
    "buildings": {
      ".read": true,
      ".write": "(auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin')",
      ".indexOn": [
        "siteId"
      ],
      "$id": {
        ".validate": "newData.hasChildren(['nameTh'])"
      }
    },
    "areas": {
      ".read": true,

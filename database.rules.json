{
  "rules": {
    ".read": false,
    ".write": false,
    "config": {
      "public": {
        ".read": true,
        ".write": "(auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin')"
      }
    },
    "users": {
      ".read": "(auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin'))",
      ".indexOn": [
        "role",
        "email"
      ],
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || (auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')))",
        ".write": "auth != null && (auth.uid == $uid || (auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'))",
        ".validate": "newData.hasChildren(['role'])",
        "role": {
          ".validate": "newData.isString() && newData.val().matches(/^(user|contractor|technician|admin)$/) && ((auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin') || (!data.exists() && newData.val() == 'user') || data.val() == newData.val() || (data.val() == 'user' && auth.token.email != null && auth.token.email_verified == true     && root.child('invites').child(auth.token.email.toLowerCase().replace('.', ',')).child('role').val() == newData.val()))"
        },
        "email": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "displayName": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "phone": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "department": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "company": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "lang": {
          ".validate": "newData.isString() && newData.val().matches(/^(th|en)$/)"
        },
        "providers": {
          "$p": {
            ".validate": "newData.isBoolean()"
          }
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "lastLoginAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "invites": {
      ".read": "(auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin')",
      "$key": {
        ".read": "auth != null && auth.token.email != null && $key == auth.token.email.toLowerCase().replace('.', ',')",
        ".write": "(auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin')",
        ".validate": "newData.hasChildren(['email', 'role']) && newData.child('role').val().matches(/^(contractor|technician)$/)"
      }
    },
    "sites": {
      ".read": true,
      ".write": "(auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin')",
      "$id": {
        ".validate": "newData.hasChildren(['nameTh'])"
      }
    },
    "buildings": {
      ".read": true,
      ".write": "(auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin')",
      ".indexOn": [
        "siteId"
      ],
      "$id": {
        ".validate": "newData.hasChildren(['nameTh'])"
      }
    },
    "areas": {
      ".read": true,
      ".write": "(auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin')",
      ".indexOn": [
        "buildingId"
      ],
      "$id": {
        ".validate": "newData.hasChildren(['nameTh', 'buildingId'])"
      }
    },
    "jobTypes": {
      ".read": true,
      ".write": "(auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin')",
      "$id": {
        ".validate": "newData.hasChildren(['nameTh'])"
      }
    },
    "counters": {
      "jobs": {
        "$year": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "$year.matches(/^20[0-9][0-9]$/) && newData.isNumber() && newData.val() == (data.exists() ? data.val() + 1 : 1)"
        }
      }
    },
    "jobs": {
      ".read": "(auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')) || (auth != null && query.orderByChild == 'reporterUid' && query.equalTo == auth.uid) || ((auth != null && root.child('users').child(auth.uid).child('role').val() == 'contractor') && query.orderByChild == 'assigneeUid' && query.equalTo == auth.uid)",
      ".indexOn": [
        "createdAt",
        "status",
        "reporterUid",
        "assigneeUid",
        "siteId",
        "jobNo",
        "trackingCode",
        "idx/s",
        "idx/o",
        "idx/si",
        "idx/sis",
        "idx/sio",
        "idx/b",
        "idx/bs",
        "idx/bo"
      ],
      "$jobId": {
        ".read": "(auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')) || (auth != null && (data.child('reporterUid').val() == auth.uid || data.child('assigneeUid').val() == auth.uid))",
        ".write": "((auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')) && (newData.exists() || (auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'))) || (auth != null && !data.exists() && newData.child('reporterUid').val() == auth.uid && newData.child('status').val() == 'new'     && !newData.hasChild('assigneeUid') && !newData.hasChild('expectedDate')     && newData.parent().parent().child('tracking').child(newData.child('trackingCode').val()).child('jobId').val() == $jobId) || ((auth != null && root.child('users').child(auth.uid).child('role').val() == 'contractor') && data.exists() && newData.exists() && data.child('assigneeUid').val() == auth.uid && newData.child('assigneeUid').val() == auth.uid)",
        ".validate": "newData.hasChildren(['jobNo', 'trackingCode', 'status', 'reporterUid', 'jobTypeId', 'buildingId', 'description', 'createdAt']) && (!data.exists() || (newData.child('jobNo').val() == data.child('jobNo').val() && newData.child('trackingCode').val() == data.child('trackingCode').val() && newData.child('reporterUid').val() == data.child('reporterUid').val()))",
        "jobNo": {
          ".validate": "newData.isString() && newData.val().matches(/^WO20[0-9][0-9]-[0-9]{4,}$/)"
        },
        "trackingCode": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{8}$/)"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(new|assigned|in_progress|on_hold|completed|cancelled)$/)"
        },
        "priority": {
          ".validate": "newData.isString() && newData.val().matches(/^(normal|urgent|low|callback)$/)"
        },
        "jobTypeId": {
          ".validate": "newData.isString() && root.child('jobTypes').child(newData.val()).exists()"
        },
        "siteId": {
          ".validate": "newData.isString() && root.child('sites').child(newData.val()).exists()"
        },
        "buildingId": {
          ".validate": "newData.isString() && root.child('buildings').child(newData.val()).exists()"
        },
        "areaId": {
          ".validate": "newData.isString()"
        },
        "locationDetail": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length <= 3000 && newData.val().length > 0"
        },
        "gps": {
          ".validate": "newData.hasChildren(['lat', 'lng'])",
          "lat": {
            ".validate": "newData.isNumber()"
          },
          "lng": {
            ".validate": "newData.isNumber()"
          },
          "accuracy": {
            ".validate": "newData.isNumber()"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$o": {
            ".validate": false
          }
        },
        "reporterUid": {
          ".validate": "newData.isString()"
        },
        "reporter": {
          ".validate": "newData.hasChildren(['name', 'email', 'phone'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().length > 0"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length <= 160 && newData.val().length > 0"
          },
          "phone": {
            ".validate": "newData.isString() && newData.val().length <= 40 && newData.val().length > 0"
          },
          "department": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "$o": {
            ".validate": false
          }
        },
        "lang": {
          ".validate": "newData.isString() && newData.val().matches(/^(th|en)$/)"
        },
        "pdpaAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "assigneeUid": {
          ".validate": "newData.isString()"
        },
        "assigneeName": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "expectedDate": {
          ".validate": "newData.isNumber()"
        },
        "expectedNote": {
          ".validate": "newData.isString() && newData.val().length <= 1000"
        },
        "hold": {
          "reason": {
            ".validate": "newData.isString() && newData.val().matches(/^(waiting_parts|budget|contractor|access|other)$/)"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "resumeDate": {
            ".validate": "newData.isNumber()"
          },
          "partsEta": {
            ".validate": "newData.isNumber()"
          },
          "since": {
            ".validate": "newData.isNumber()"
          },
          "$o": {
            ".validate": false
          }
        },
        "workDetail": {
          ".validate": "newData.isString() && newData.val().length <= 3000"
        },
        "photos": {
          "$pid": {
            ".write": "auth != null && data.parent().parent().child('reporterUid').val() == auth.uid",
            ".validate": "newData.hasChildren(['store', 'w', 'h', 'bytes']) && newData.child('w').val() <= 1280 && newData.child('h').val() <= 1280 && newData.child('bytes').val() <= 409600"
          }
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "updatedAt": {
          ".write": "auth != null && data.parent().child('reporterUid').val() == auth.uid",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "completedAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "idx": {
          "$k": {
            ".validate": "$k.matches(/^(s|o|si|sis|sio|b|bs|bo)$/) && newData.isString() && newData.val().length <= 200"
          }
        },
        "files": {
          ".validate": false
        },
        "cpfm": {
          ".validate": false
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "jobPhotos": {
      "$jobId": {
        ".read": "(auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')) || (auth != null && (root.child('jobs').child($jobId).child('reporterUid').val() == auth.uid || root.child('jobs').child($jobId).child('assigneeUid').val() == auth.uid))",
        "$pid": {
          ".write": "(auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')) || (auth != null && (root.child('jobs').child($jobId).child('reporterUid').val() == auth.uid || root.child('jobs').child($jobId).child('assigneeUid').val() == auth.uid))",
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/webp;base64,') && newData.val().length < 560000"
        }
      }
    },
    "jobEvents": {
      "$jobId": {
        ".read": "(auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')) || (auth != null && root.child('jobs').child($jobId).child('assigneeUid').val() == auth.uid)",
        "$eventId": {
          ".write": "auth != null && !data.exists() && newData.child('byUid').val() == auth.uid && ((auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')) || ((auth != null && root.child('users').child(auth.uid).child('role').val() == 'contractor') && newData.parent().parent().parent().child('jobs').child($jobId).child('assigneeUid').val() == auth.uid) || (newData.parent().parent().parent().child('jobs').child($jobId).child('reporterUid').val() == auth.uid     && newData.child('public').val() == true && newData.child('type').val().matches(/^(created|comment)$/)))",
          ".validate": "newData.hasChildren(['at', 'byUid', 'type', 'public']) && newData.child('type').val().matches(/^(created|status|assign|expected|hold|comment|photo)$/)",
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now + 60000"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 3000"
          },
          "public": {
            ".validate": "newData.isBoolean()"
          },
          "imported": {
            ".validate": false
          }
        }
      }
    },
    "tracking": {
      "$code": {
        ".read": true,
        ".write": "(auth != null && (root.child('users').child(auth.uid).child('role').val() == 'technician' || root.child('users').child(auth.uid).child('role').val() == 'admin')) || (auth != null && !data.exists() && newData.parent().parent().child('jobs').child(newData.child('jobId').val()).child('reporterUid').val() == auth.uid     && newData.parent().parent().child('jobs').child(newData.child('jobId').val()).child('trackingCode').val() == $code) || ((auth != null && root.child('users').child(auth.uid).child('role').val() == 'contractor') && data.exists() && newData.exists() && root.child('jobs').child(data.child('jobId').val()).child('assigneeUid').val() == auth.uid)",
        ".validate": "newData.hasChildren(['jobId', 'jobNo', 'status']) && $code.matches(/^[A-Z0-9]{8}$/) && (!data.exists() || newData.child('jobId').val() == data.child('jobId').val())",
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(new|assigned|in_progress|on_hold|completed|cancelled)$/)"
        },
        "updatedAt": {
          ".write": "auth != null && root.child('jobs').child(data.parent().child('jobId').val()).child('reporterUid').val() == auth.uid",
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "timeline": {
          "$eid": {
            ".write": "auth != null && !data.exists() && root.child('jobs').child(data.parent().parent().child('jobId').val()).child('reporterUid').val() == auth.uid && newData.child('type').val() == 'comment'",
            ".validate": "newData.hasChildren(['at', 'type'])",
            "note": {
              ".validate": "newData.isString() && newData.val().length <= 3000"
            }
          }
        }
      }
    },
    "mail": {
      ".read": "(auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin')",
      ".write": false
    }
  }
}

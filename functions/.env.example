# Copy to functions/.env (non-secret params). SMTP_PASS is a secret: firebase functions:secrets:set SMTP_PASS
APP_URL=https://vistec-repair.web.app
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=repair-noreply@vistec.ac.th
MAIL_FROM="VISTEC Repair <repair-noreply@vistec.ac.th>"
# comma separated — receive an e-mail for every new request
STAFF_NOTIFY_EMAILS=facility@vistec.ac.th

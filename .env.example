# Firebase console → Project settings → General → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=vistec-repair.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://vistec-repair-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=vistec-repair
VITE_FIREBASE_STORAGE_BUCKET=vistec-repair.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Microsoft Entra ID tenant for VISTEC (tenant id or domain, e.g. vistec.ac.th). Empty = any Microsoft account.
VITE_MS_TENANT=vistec.ac.th

# Where photos are stored: "storage" (Firebase Storage, needs Blaze plan) or "rtdb" (base64 WebP inside RTDB)
VITE_IMAGE_STORE=storage

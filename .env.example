# Firebase console → Project settings → General → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=vistec-repair.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://vistec-repair-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=vistec-repair
VITE_FIREBASE_STORAGE_BUCKET=vistec-repair.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Microsoft Entra ID tenant for VISTEC (tenant id or domain, e.g. vistec.ac.th). Empty = any Microsoft account.
VITE_MS_TENANT=vistec.ac.th

# Where photos are stored: "storage" (Firebase Storage, needs Blaze plan) or "rtdb" (base64 WebP inside RTDB)
VITE_IMAGE_STORE=storage

# Which sign-in buttons the login page offers. Turn one off (false / 0 / no / off) if the matching
# provider is NOT enabled in Firebase Console → Authentication → Sign-in method — otherwise the button
# is shown and fails with auth/configuration-not-found. Unset or empty = on.
VITE_AUTH_MICROSOFT=true
VITE_AUTH_GOOGLE=true
VITE_AUTH_PASSWORD=true
VITE_AUTH_EMAIL_LINK=true

# Old CPFM system — only used by `npm run import:cpfm` (scripts/import-cpfm.mjs, see CPFM_IMPORT.md). Never commit real values.
EXISTING_SYSTEM_URL=https://enco.bi-cpfm.com/
EXISTING_SYSTEM_USERNAME=
EXISTING_SYSTEM_PASSWORD=
# Admin key for the importer: Project settings → Service accounts → Generate new private key (git-ignored)
FIREBASE_SERVICE_ACCOUNT=./service-account.json
